# Optional canonical site base URL (no default domain).
# When set (e.g. https://example.com): enables metadataBase, canonical link, Allow: / + Sitemap in robots.txt, and sitemap.xml entry.
# When unset or empty: omits canonical link, sets robots.txt to Disallow: /, and emits an empty sitemap.xml.
# NEXT_PUBLIC_SITE_URL=

# End-to-end testing flag: set to 1 during test harness runs to expose __CONCEPFUL* debug hooks on window
NEXT_PUBLIC_E2E=0
